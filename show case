    <row>
        <panel>
            <title>Demo: Big jump (▲ +20 on last point)</title>
            <search id="gallery_fsv_demo_jump">
                <query>
| makeresults count=20
| streamstats count as n
| eval _time = relative_time(now(), "-" . (n - 1) . "m@m")
| eval value = 25 + n
| eventstats max(n) as max_n
| eval value = if(n = max_n, value + 20, value)
| fields _time value
| sort 0 _time
                </query>
                <earliest>-4h@h</earliest>
