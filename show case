    <row>
        <panel>
            <title>Demo: Up (last &gt; previous)</title>
            <search id="gallery_fsv_demo_up">
                <query>
| makeresults count=20
| streamstats count as n
| eval _time = relative_time(now(), "-" . (n - 1) . "m@m")
| eval value = 20 + (n * 2)
| fields _time value
| sort 0 _time
                </query>
                <earliest>-4h@h</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.fixed_single_value">
                <search base="gallery_fsv_demo_up" />
            </viz>
            <table>
                <title>Data</title>
                <search base="gallery_fsv_demo_up" />
                <option name="count">20</option>
                <option name="drilldown">none</option>
                <option name="sortCol">_time</option>
                <option name="sortDir">asc</option>
            </table>
        </panel>
